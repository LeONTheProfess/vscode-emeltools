{
    "name": "vscode-emel",
    "displayName": "EME-L",
    "description": "Syntax highlighting and code snippets for the EME-L language",
    "version": "0.2.0",
    "icon": "images/EME-L.png",
    "publisher": "LeONTheProfess",
    "repository": {
        "type": "git",
        "url": "https://github.com/LeONTheProfess/vscode-emeltools.git"
    },
    "scripts": {
        "package": "vsce package"
    },
    "engines": {
        "vscode": "^1.61.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "emel",
            "aliases": ["emel", "EME-L"],
            "extensions": [".emel"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "emel",
            "scopeName": "source.emel",
            "path": "./syntaxes/emel.tmLanguage.json"
        }],
        "snippets": [
            {
                "language": "emel",
                "path": "./snippets/emel.snippets.json"
            }
        ]
    },
    "devDependencies": {
        "@vscode/vsce": "^3.3.2"
    }
}